# Copy to .env in this directory. Do not commit the resulting file.
# Use the Neon connection string, including sslmode=require.
DATABASE_URL=
DATABASE_POOL_MAX_CONNS=10
# Set PAYMENT_MODE=mock only with HTTP_ADDRESS=127.0.0.1:8080 and a local PUBLIC_APP_URL.
PAYMENT_MODE=vnpay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/payment/result
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_APP_URL=http://localhost:3000
